# From the chart: kubectl -n appwrite get secret appwrite -o jsonpath='{.data.executor-secret}' | base64 -d
EXECUTOR_SECRET=
# Also write the orchestrator secret to ./orchestrator-api-key (no trailing newline):
#   kubectl -n appwrite get secret appwrite -o jsonpath='{.data.orchestrator-secret}' | base64 -d > orchestrator-api-key

# Same S3 bucket and credentials as appwrite.storage.s3.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
EXECUTOR_STORAGE_DSN=s3://ACCESS_KEY:SECRET_KEY@s3.example.com?region=us-east-1

# Match compute.functionsRuntimes and compute.sitesRuntimes.
RUNTIMES=node-22,static-1
RUNTIME_IMAGES=openruntimes/node:v5-22,openruntimes/static:v5-1

EXECUTOR_PORT=9900
ORCHESTRATOR_PORT=8080
