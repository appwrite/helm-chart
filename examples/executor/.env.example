# Copy to .env and fill in. See docs/executor.md.

# The chart's executor secret:
#   kubectl -n appwrite get secret appwrite -o jsonpath='{.data.executor-secret}' | base64 -d
EXECUTOR_SECRET=
EXECUTOR_PORT=9900

# The bucket Appwrite uses, as a DSN. With an S3 endpoint set in Appwrite,
# leave the bucket out; with AWS S3, put it in the hostname:
#   s3://KEY:SECRET@BUCKET.s3.REGION.amazonaws.com?region=REGION
EXECUTOR_STORAGE_DSN=s3://ACCESS_KEY:SECRET_KEY@s3.example.com?region=us-east-1

# compute.functionsRuntimes and compute.sitesRuntimes combined, and their images.
RUNTIMES=node-22,static-1
RUNTIME_IMAGES=openruntimes/node:v5-22,openruntimes/static:v5-1

# Seconds before an idle runtime is stopped.
INACTIVE_THRESHOLD=60

# Optional, to avoid Docker Hub pull limits.
DOCKER_HUB_USERNAME=
DOCKER_HUB_PASSWORD=
